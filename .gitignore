# =============================================================================
# darasa — .gitignore
# =============================================================================

# --- Build / generated ----------------------------------------------------
dist/
.astro/
.cache/
.tmp/
.parcel-cache/
coverage/

# --- Dependencias ---------------------------------------------------------
node_modules/

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variables de entorno -------------------------------------------------
.env
.env.*
!.env.example

# --- Sistema operativo ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editores / IDEs ------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# --- Asistentes IA / agentes ---------------------------------------------
.agents/
.claude/
.cursor/
.cursorrules
.windsurf/
.continue/
.codeium/
.aider*
.copilot/
.gpt*
.codex/
.serena/
.playwright-mcp/
skills-lock.json

# --- Imágenes -------------------------------------------------------------
# Los retratos se versionan para reproducibilidad de CI en validate:links.
# El fichero de atribuciones sí se versiona — es la traza legal CC BY-SA.
!public/portraits/ATTRIBUTIONS.md

# --- Notas de traspaso por sesión ----------------------------------------
# Los HANDOVER-*.md son notas de transferencia de sesiones Sonnet pasadas.
# Su contenido queda reflejado en git log + docs/MIGRATION-TODO.md.
HANDOVER-*.md

