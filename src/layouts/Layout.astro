---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'darasa — cronología interactiva de reyes e imperios de la Península Ibérica.',
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://darasa.es').href;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site ?? 'https://darasa.es').href
  : undefined;
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="darasa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;800&family=Fraunces:ital,opsz,wght,SOFT,WONK@1,9..144,400..700,0..100,0..1&family=Geist+Mono:wght@400..700&display=swap"
    />

    <script src="/scripts/theme.js" is:inline></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" aria-label="darasa · inicio">
          <svg
            class="brand-mark"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M12 3 L3 8 V16 L12 21 L21 16 V8 Z" stroke-linejoin="round" />
            <path d="M12 3 V21 M3 8 L21 8 M3 16 L21 16" opacity="0.4" />
          </svg>
          <span class="brand-name">darasa</span>
          <span class="brand-tag">reyes e imperios</span>
        </a>
        <button
          class="theme-toggle"
          type="button"
          aria-pressed="false"
          aria-label="Alternar modo claro / oscuro"
        >
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path
              d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
            />
          </svg>
          <svg
            class="icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M20 14.4A7.8 7.8 0 0 1 9.6 4a8 8 0 1 0 10.4 10.4z" />
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p>
            <strong>darasa</strong> — cronología de reyes e imperios de la Península Ibérica. Retratos de
            <a href="https://commons.wikimedia.org/" rel="noopener noreferrer">Wikimedia Commons</a>, dominio público. Tipografías
            <a href="https://fonts.google.com/specimen/Hanken+Grotesk" rel="noopener noreferrer">Hanken Grotesk</a>,
            <a href="https://fonts.google.com/specimen/Fraunces" rel="noopener noreferrer">Fraunces</a> y
            <a href="https://fonts.google.com/specimen/Geist+Mono" rel="noopener noreferrer">Geist Mono</a>, SIL OFL.
          </p>
        </div>
        <a
          class="cc"
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          rel="license"
          aria-label="Licencia Creative Commons Atribución-CompartirIgual 4.0 Internacional"
        >
          <span class="cc-circle" aria-hidden="true">cc</span>
          <span>BY-SA 4.0</span>
        </a>
      </div>
    </footer>
  </body>
</html>
