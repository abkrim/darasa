---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entidades = await getCollection('entidades');
const entidadesOrdenadas = entidades.sort((a, b) => a.data.inicio - b.data.inicio);

const soberanos = await getCollection('soberanos');
const totalSoberanos = soberanos.length;

const AÑO_ACTUAL = new Date().getFullYear();

// Eje temporal fijo (400 → 2030) cubre desde visigodos hasta el presente.
// Cuando se añadan entidades pre-400 (p.ej. Hispania romana) se ajusta aquí.
const EJE_INICIO = 400;
const EJE_FIN = 2030;

const X0 = 48;
const X1 = 878;
const ROW_H = 34;
const ROW_GAP = 8;
const TOP = 14;

function xOf(year) {
  return X0 + ((year - EJE_INICIO) / (EJE_FIN - EJE_INICIO)) * (X1 - X0);
}

// Asignación de filas: cada entidad en su propia fila. Con solapes temporales
// (Al-Ándalus ↔ reinos norte) sesión /plan-eng-review separada para multi-carril.
const bloques = entidadesOrdenadas.map((ent, idx) => {
  const finReal = ent.data.fin == null ? AÑO_ACTUAL : ent.data.fin;
  const x1 = xOf(ent.data.inicio);
  const x2 = xOf(finReal);
  const w = Math.max(12, x2 - x1);
  return {
    slug: ent.data.slug,
    nombre: ent.data.nombre,
    colorVar: ent.data.colorVar,
    inicio: ent.data.inicio,
    fin: ent.data.fin,
    finReal,
    x: x1,
    y: TOP + idx * (ROW_H + ROW_GAP),
    w,
    mostrarLabel: w > 120,
  };
});

const axisY = TOP + Math.max(1, bloques.length) * (ROW_H + ROW_GAP) + 18;
const svgHeight = axisY + 32;

const añosEje = [500, 700, 900, 1100, 1300, 1500, 1700, 1900];

const añosHistoria = bloques.length === 0
  ? 0
  : AÑO_ACTUAL - Math.min(...bloques.map((b) => b.inicio));
---

<Layout
  title="darasa · reyes e imperios de Hispania"
  description={`Cronología de reyes e imperios de la Península Ibérica. ${entidadesOrdenadas.length} ${entidadesOrdenadas.length === 1 ? 'entidad política' : 'entidades políticas'}, ${totalSoberanos} soberanos documentados.`}
>
  <main id="main" class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow hero-eyebrow">
        darasa · <span class="numeric">{EJE_INICIO} – {AÑO_ACTUAL}</span>
      </p>
      <h1 id="hero-title" class="hero-title">
        Los reyes e imperios, <span class="display-italic">contados en cronología</span>.
      </h1>
      <p class="hero-sub">
        Cronología abierta de las entidades políticas de la Península Ibérica. Selecciona cualquier bloque del timeline para conocer sus soberanos.
      </p>
      <div class="hero-meta">
        <span><strong class="numeric">{añosHistoria}</strong> años de historia</span>
        <span><strong class="numeric">{entidadesOrdenadas.length}</strong> {entidadesOrdenadas.length === 1 ? 'entidad política' : 'entidades políticas'}</span>
        <span><strong class="numeric">{totalSoberanos}</strong> soberanos documentados</span>
      </div>
    </section>

    <section class="section" aria-labelledby="tl-title">
      <header class="section-head">
        <span class="label">Timeline</span>
        <h2 id="tl-title">Cronología por entidad</h2>
      </header>

      <div class="tl-wrap">
        <svg
          class="tl-svg"
          viewBox={`0 0 900 ${svgHeight}`}
          role="img"
          aria-labelledby="tl-title tl-desc"
        >
          <desc id="tl-desc">
            Diagrama visual de las entidades políticas de Hispania entre {EJE_INICIO} y {AÑO_ACTUAL}. Cada bloque es un enlace a la página de su entidad.
          </desc>

          <line
            x1={X0}
            x2={X1}
            y1={axisY}
            y2={axisY}
            stroke="var(--rule-strong)"
            stroke-width="1"
          />
          {añosEje
            .filter((y) => y > EJE_INICIO && y < EJE_FIN)
            .map((y) => (
              <>
                <line
                  x1={xOf(y)}
                  x2={xOf(y)}
                  y1={axisY - 4}
                  y2={axisY + 4}
                  stroke="var(--rule)"
                  stroke-width="1"
                />
                <text
                  x={xOf(y)}
                  y={axisY + 18}
                  text-anchor="middle"
                  class="tl-axis-year"
                >
                  {y}
                </text>
              </>
            ))}
          <text x={X0} y={axisY + 18} text-anchor="start" class="tl-axis-year">
            {EJE_INICIO}
          </text>
          <text x={X1} y={axisY + 18} text-anchor="end" class="tl-axis-year">
            {AÑO_ACTUAL}
          </text>

          {bloques.map((b) => {
            const HIT = 44;
            const hitY = b.y + (ROW_H - HIT) / 2;
            const hitW = Math.max(b.w, HIT);
            const hitX = b.x - (hitW - b.w) / 2;
            return (
              <a href={`/hispania/${b.slug}`} aria-label={`${b.nombre}, ${b.inicio} a ${b.fin ?? 'hoy'}`}>
                {/* Rect transparente amplía el área táctil a 44×44 mín. (WCAG 2.5.8) */}
                <rect x={hitX} y={hitY} width={hitW} height={HIT} fill="transparent" />
                <rect
                  x={b.x}
                  y={b.y}
                  width={b.w}
                  height={ROW_H}
                  rx="14"
                  ry="14"
                  fill={`var(${b.colorVar}-solid)`}
                  class="tl-block"
                />
                {b.mostrarLabel && (
                  <text
                    x={b.x + b.w / 2}
                    y={b.y + ROW_H / 2 + 5}
                    text-anchor="middle"
                    fill="#fff"
                    class="tl-block-label"
                  >
                    {b.nombre}
                  </text>
                )}
              </a>
            );
          })}
        </svg>

        <noscript>
          <ol class="tl-fallback">
            {entidadesOrdenadas.map((ent) => (
              <li>
                <a href={`/hispania/${ent.data.slug}`}>
                  <strong>{ent.data.nombre}</strong>
                </a>
                <span class="numeric"> · {ent.data.inicio} – {ent.data.fin ?? 'hoy'}</span>
                {' — '}
                {ent.data.desc.replace(/\s+/g, ' ').slice(0, 120).trim()}…
              </li>
            ))}
          </ol>
        </noscript>
      </div>

      <p class="tl-caption">
        Selecciona un bloque del diagrama para ver los soberanos de esa entidad.
      </p>
    </section>
  </main>
</Layout>

<style>
  .tl-block {
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease);
    transform-origin: center;
    transform-box: fill-box;
    cursor: pointer;
  }
  a:hover .tl-block,
  a:focus-visible .tl-block {
    transform: scaleY(1.08);
    filter: brightness(1.05);
  }
  a:focus-visible .tl-block {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .tl-block-label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 700;
    pointer-events: none;
  }
  .tl-axis-year {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    fill: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-block {
      transition: none;
    }
    a:hover .tl-block,
    a:focus-visible .tl-block {
      transform: none;
    }
  }
</style>
